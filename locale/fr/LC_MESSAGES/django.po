msgid ""
"Política de privacidad y tratamiento de datos personales de la Asociación "
"Nuclear Colombiana (ASNC). Conoce cómo protegemos tu información."
msgstr ""
"Politique de confidentialité et de traitement des données personnelles de "
"l'Asociación Nuclear Colombiana (ASNC). Découvrez comment nous protégeons "
"vos informations."

msgid "Documento Legal"
msgstr "Document juridique"

msgid "Política de Privacidad y Tratamiento de Datos Personales"
msgstr ""
"Politique de confidentialité et de traitement des données personnelles"

msgid "Última actualización: Marzo 2026"
msgstr "Dernière mise à jour : mars 2026"

