msgstr "Blog ASNC"

msgid "Noticias y Novedades"
msgstr "Actualités et nouveautés"

msgid "Lo último del sector nuclear colombiano y la comunidad ASNC"
msgstr ""
"Les dernières nouvelles du secteur nucléaire colombien et de la communauté "
"ASNC"

msgid "Leer más"
msgstr "Lire la suite"

msgid "Estamos preparando contenido para ti. ¡Vuelve pronto!"
msgstr "Nous préparons du contenu pour vous. Revenez bientôt !"

msgid "Todas las noticias"
msgstr "Toutes les actualités"

msgid "Compartir:"
msgstr "Partager :"

msgid "Más noticias"
msgstr "Plus d'actualités"

msgid ""
"Ponte en contacto con la Asociación Nuclear Colombiana (ASNC). Escríbenos "
"tus dudas, propuestas o solicitudes."
msgstr ""
"Entrez en contact avec la Asociación Nuclear Colombiana (ASNC). Écrivez-nous"
" vos questions, propositions ou demandes."

msgid "Contáctanos"
msgstr "Contactez-nous"

msgid ""
"¿Tienes preguntas, propuestas o quieres saber más sobre la ASNC? Estamos "
"para ayudarte."
msgstr ""
"Vous avez des questions, des propositions ou souhaitez en savoir plus sur "
"l'ASNC ? Nous sommes là pour vous aider."

