msgid ""
"Política de privacidad y tratamiento de datos personales de la Asociación "
"Nuclear Colombiana (ASNC). Conoce cómo protegemos tu información."
msgstr ""
"Política de privacidade e tratamento de dados pessoais da Asociación Nuclear"
" Colombiana (ASNC). Saiba como protegemos suas informações."

msgid "Documento Legal"
msgstr "Documento Legal"

msgid "Política de Privacidad y Tratamiento de Datos Personales"
msgstr "Política de Privacidade e Tratamento de Dados Pessoais"

msgid "Última actualización: Marzo 2026"
msgstr "Última atualização: Março de 2026"

